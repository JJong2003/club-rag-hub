{
  // 명령 팔레트 > "Tasks: Run Task"에서 실행합니다. 모두 Git Bash로 돌아갑니다.
  "version": "2.0.0",
  "options": {
    "shell": { "executable": "C:\\Program Files\\Git\\bin\\bash.exe", "args": ["-c"] }
  },
  "tasks": [
    {
      "label": "infra: 00 실행 전 확인",
      "type": "shell",
      "command": "bash infra/00_check.sh",
      "problemMatcher": []
    },
    {
      "label": "infra: 전체 생성 (run_all)",
      "type": "shell",
      "command": "bash infra/run_all.sh",
      "problemMatcher": []
    },
    {
      "label": "github: Actions 시크릿 등록 (06)",
      "type": "shell",
      "command": "bash infra/06_github_actions.sh",
      "problemMatcher": []
    },
    {
      "label": "app: 테스트 (pytest)",
      "type": "shell",
      "command": ".venv/Scripts/python -m pytest -q",
      "problemMatcher": []
    },
    {
      // 이 PC에서 sam build + sam deploy 후 /health 호출. 평소 배포는 main push로 Actions가 합니다.
      "label": "app: 빌드와 배포 (sam)",
      "type": "shell",
      "command": "bash infra/deploy_app.sh",
      "problemMatcher": []
    },
    {
      "label": "app: /health 호출",
      "type": "shell",
      "command": "source infra/.state/outputs.env && curl -sS \"$HEALTH_URL\" && echo",
      "problemMatcher": []
    },
    {
      // data/school/ → S3 school/. 조문(kb/)이 바뀌었으면 KB school 동기화까지 합니다.
      "label": "data: S3 올리기 (학교 규정 school/)",
      "type": "shell",
      "command": ".venv/Scripts/python scripts/sync_s3.py school",
      "problemMatcher": []
    },
    {
      // data/clubs/ana/manifest.json의 masked, skipped를 확인한 뒤 실행합니다.
      "label": "data: S3 올리기 (ANA 자료 clubs/ana/, 가림 검토 후)",
      "type": "shell",
      "command": ".venv/Scripts/python scripts/sync_s3.py clubs/ana",
      "problemMatcher": []
    },
    {
      "label": "data: S3 올리기 (수집 원본 _sources/)",
      "type": "shell",
      "command": ".venv/Scripts/python scripts/sync_s3.py _sources",
      "problemMatcher": []
    },
    {
      "label": "infra: 태그로 리소스 조회",
      "type": "shell",
      "command": "bash infra/list_tagged.sh",
      "problemMatcher": []
    },
    {
      // Lambda 런타임(python3.12)과 같은 버전으로 .venv를 지우고 다시 만듭니다.
      // --seed: venv 안에 pip을 넣습니다. 없으면 활성화 상태에서도 pip이 시스템 Python에 설치합니다.
      "label": "python: 가상환경 다시 만들기 (3.12)",
      "type": "shell",
      "command": "uv venv --clear --seed --python 3.12 .venv && uv pip install --python .venv -r requirements-dev.txt",
      "problemMatcher": []
    }
  ]
}
