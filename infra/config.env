# 스크립트 설정값입니다. 리소스를 한 번 만든 뒤에는 PREFIX를 바꾸지 마세요.
# 메일 주소는 저장소에 올라가지 않도록 config.local.env에 적습니다 (README 참고).

PREFIX="club-rag-hub"              # 리소스 이름 앞부분 (소문자, 숫자, 하이픈 3~20자)
AWS_PROFILE_NAME="club-rag-hub"    # aws configure --profile 에 쓴 이름
AWS_REGION="ap-northeast-2"        # 서울 리전

GITHUB_OWNER="JJong2003"
GITHUB_REPO="club-rag-hub"         # GitHub Actions가 배포 역할을 받을 저장소

BUDGET_USD="5"                     # 월 예산 알림 기준 금액 (달러)
ALERT_EMAIL="${ALERT_EMAIL:-}"     # config.local.env에서 채움

TAG_KEY="Project"
TAG_VALUE="cloudarchitect-termproj"
